    "test": "node tools/test.mjs",
    "start": "node runtime/start.mjs",
    "test:link": "node tools/test-link.mjs",
    "audio:bake": "vite --config tools/audio-bake.config.mjs"
  },
  "keywords": [
    "kart",
    "racing",
    "threejs",
    "web-game",
    "rocket",
    "motion-controller"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "n8ao": "^2.0.0",
    "postprocessing": "^6.39.3",
    "qrcode": "^1.5.4",
    "simplex-noise": "^4.0.3",
    "three": "^0.185.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "@types/three": "^0.185.1",
    "puppeteer": "^25.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://cccircccle715.github.io/chinese-can-fly-kart/",
